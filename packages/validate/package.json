{
  "name": "@nuskha/validate",
  "version": "0.0.0",
  "description": "Typed wrapper around the HL7 FHIR validator, pinned to the ABDM implementation guide.",
  "license": "Apache-2.0",
  "keywords": [
    "fhir",
    "abdm",
    "hl7",
    "validator"
  ],
  "homepage": "https://github.com/AryanDevel/Nuskha#readme",
  "bugs": {
    "url": "https://github.com/AryanDevel/Nuskha/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AryanDevel/Nuskha.git",
    "directory": "packages/validate"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "fetch-validator": "node scripts/fetch-validator.ts"
  },
  "dependencies": {
    "@nuskha/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
