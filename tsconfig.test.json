{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@nuskha/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/scripts/**/*",
    "apps/*/src/**/*",
    "vitest.config.ts"
  ]
}
